{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "removeComments": false,
    "preserveConstEnums": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "strictNullChecks": false,
    "sourceMap": true,
    "baseUrl": "./src",
    "skipLibCheck": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": ["./*"],
      "@core": ["../node_modules/wechat-core-app"],
      "@http": ["./http"],
      "@api/*": ["./service/api/*"]
    }
  },
  "include": ["./src", "./types", "./config"],
  "compileOnSave": false
}
