{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/main/core/tauri-config-schema/schema.json",
  "identifier": "default",
  "description": "Default capabilities for GAL Editor & Player windows",
  "windows": ["main", "preview", "player-dev"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-set-webview-size",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "shell:default"
  ]
}
